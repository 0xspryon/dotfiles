{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--viewport",
        "1280x720",
        "--profilePath",
        "./firefox-profile/"
      ],
      "enabled": true,
      "env": {
        "START_URL": "about:blank"
      }
    }
  }
}
