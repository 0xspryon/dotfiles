#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.fzf/bin:$PATH"

store="${PASSWORD_STORE_DIR:-$HOME/.password-store}"

# ---------- inner: runs inside kitty ----------
if [ "${1:-}" = "--inner" ]; then
  out="$2"
  entries=$(find "$store" -path "$store/.git" -prune -o -name '*.gpg' -printf '%P\n' |
    sed 's/\.gpg$//' | sort)
  printf '%s\n' "$entries" |
    fzf --prompt='pass> ' --height=100% --layout=reverse --info=inline \
      >"$out" || true
  exit 0
fi

# ---------- outer ----------
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

# Blocks until kitty exits.
kitty --class=pass-menu --title=pass \
  -o hide_window_decorations=yes \
  -o remember_window_size=no \
  -o initial_window_width=70c \
  -o initial_window_height=18c \
  -o confirm_os_window_close=0 \
  -e "$0" --inner "$tmp"

choice=$(cat "$tmp")
[ -n "$choice" ] || exit 0

# Decrypt only after kitty is gone. Never touches disk, clipboard, or argv.
pw=$(pass show "$choice" | sed -n '1p')

sleep 0.2 # let Mutter hand focus back to the original window
printf '%s' "$pw" | ydotool type --file -
